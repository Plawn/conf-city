{
  "name": "conf-city",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "bunx tsc --noEmit",
    "build": "bunx tsc --noEmit && vite build",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe --only=style/useBlockStatements . && biome check --write .",
    "format": "biome format --write .",
    "preview": "vite preview",
    "proxy": "bun proxy/server.ts",
    "dummy": "bun proxy/providers/dummy.ts",
    "sync:glass": "bun scripts/sync-glass-css.ts",
    "postinstall": "bun scripts/sync-glass-css.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@types/three": "^0.185.4",
    "glass-ui-solid": "^0.6.2",
    "luxon": "3.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "suncalc": "2.0.2",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/luxon": "^3.7.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
