# Site configuration for Docker Compose / Swarm deployments.
# Copy to `.env` (not committed) and adjust. The `justfile` loads it automatically;
# for a bare `docker compose` / `docker stack deploy`, compose reads `.env` too.

# ── Images ──────────────────────────────────────────────────────────────────
# Registry prefix every node pulls from, e.g. registry.example.com/you/conf-city.
# Mandatory on a multi-node Swarm: an image built on the manager exists nowhere
# else, so a task scheduled elsewhere fails with "pull access denied".
# Leave unset on a single-node box (images stay local, named `confcity/*`).
#REGISTRY=registry.example.com/you/conf-city

# ── Public routing (Traefik) ────────────────────────────────────────────────
# Host the frontend is served on, the Traefik entrypoint and cert resolver to use,
# and the name of the external Traefik network to join.
CONFCITY_HOST=city.localhost
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=resolver
TRAEFIK_NETWORK=traefik

# ── Placement ───────────────────────────────────────────────────────────────
# Swarm placement constraint for the frontend and the proxy. With no registry the
# image only exists on the node that built it, so pin it there:
#   DEPLOY_CONSTRAINT="node.hostname == my-builder-node"
DEPLOY_CONSTRAINT="node.role == manager"

# ── Logs (docker-compose.victorialogs.yml only) ─────────────────────────────
# URL of VictoriaLogs and the external network it is attached to.
VICTORIALOGS_URL=http://victorialogs:9428
VICTORIALOGS_NETWORK=monitoring_obs

# ── Optional ────────────────────────────────────────────────────────────────
# Comma-separated services treated as ambient infrastructure: links pointing at
# them are not drawn (the building stays). Same effect as `confcity.ambient=true`.
#AMBIENT_SERVICES=keycloak_keycloak
