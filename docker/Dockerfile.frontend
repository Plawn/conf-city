FROM oven/bun:1-alpine AS build

WORKDIR /app

COPY package.json bun.lock* ./
COPY scripts/ scripts/
RUN BUN_FROZEN_LOCKFILE=0 bun install

COPY index.html vite.config.ts tsconfig.json ./
COPY src/ src/
# The only proxy files the frontend is allowed to share (@proxy/ alias). Listed one by
# one on purpose: this is the architectural boundary, and a local typecheck cannot
# catch a missing one — the alias resolves against the whole repo outside Docker.
COPY proxy/protocol.ts proxy/logKey.ts proxy/
COPY public/ public/

RUN bun run build

# ── Serve with nginx ──
FROM nginx:alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
