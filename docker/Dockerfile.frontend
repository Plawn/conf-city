# The build stage runs on the builder's own arch: its output is static files, so a
# multi-arch build compiles once instead of under QEMU.
FROM --platform=$BUILDPLATFORM oven/bun:1.3.11-alpine AS build

WORKDIR /app

COPY package.json bun.lock ./
COPY scripts/ scripts/
RUN bun install --frozen-lockfile

COPY index.html vite.config.ts tsconfig.json ./
COPY src/ src/
# The only proxy files the frontend is allowed to share (@proxy/ alias). Listed one by
# one on purpose: this is the architectural boundary, and a local typecheck cannot
# catch a missing one — the alias resolves against the whole repo outside Docker.
COPY proxy/protocol.ts proxy/logKey.ts proxy/
COPY public/ public/

RUN bun run build

# ── Serve with nginx ──
FROM nginx:1.30-alpine

# Rendered by the image's entrypoint (envsubst on defined variables only, so nginx's own
# `$host`, `$uri`… are left alone).
ENV PROXY_UPSTREAM=proxy:4001
COPY docker/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
