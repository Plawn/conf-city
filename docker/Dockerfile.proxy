FROM oven/bun:1.3.11-alpine

WORKDIR /app

# No `bun install`: the proxy imports nothing but Bun and Node built-ins.
COPY package.json ./
COPY proxy/ proxy/
COPY src/data/sample.json src/data/sample.json

ENV PROXY_PORT=4001
EXPOSE 4001
USER bun

HEALTHCHECK --interval=10s --timeout=3s \
  CMD wget -qO- http://localhost:4001/health || exit 1

CMD ["bun", "proxy/server.ts"]
