FROM oven/bun:1.3.11-alpine

WORKDIR /app

# No `bun install`: the providers import nothing but Bun and Node built-ins.
COPY package.json ./
COPY proxy/ proxy/
COPY src/data/sample.json src/data/sample.json

ARG PROVIDER_SCRIPT=proxy/providers/dummy.ts
ENV PROVIDER_SCRIPT=${PROVIDER_SCRIPT}
ENV PROXY_URL=ws://proxy:4001/ws/provider

CMD ["sh", "-c", "exec bun $PROVIDER_SCRIPT"]
